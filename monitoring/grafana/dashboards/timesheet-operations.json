{
  "uid": "timesheet-ops",
  "title": "Timesheet - Operations (DevSecOps)",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "tags": [
    "devsecops",
    "operations"
  ],
  "annotations": {
    "list": [
      {
        "name": "Panne injectee (redondance perdue)",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ops"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "ALERTS{alertname=\"TimesheetAppDegraded\",alertstate=\"firing\"}",
        "step": "15s",
        "titleFormat": "Pod tue - redondance perdue"
      },
      {
        "name": "Coupure du service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-ops"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertname=\"TimesheetAppDown\",alertstate=\"firing\"}",
        "step": "15s",
        "titleFormat": "Service injoignable"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "## Timesheet - Supervision en exploitation (phase Operations DevSecOps)\n**Disponibilite** du service | **Resilience** face aux pannes injectees par *kube-monkey* (lignes verticales orange) | **Performance** applicative | **Pipeline** CI/CD Jenkins. Sources : Prometheus, kube-state-metrics, Spring Boot Actuator, plugin Prometheus de Jenkins."
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Disponibilite",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Application",
      "description": "Le service repond-il via le NodePort 30089 ?",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "up{job=\"timesheet-app\"}",
          "legendFormat": "timesheet-app",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "gauge",
      "title": "Disponibilite 24 h",
      "description": "Part des mesures ou le service repondait",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "avg_over_time(up{job=\"timesheet-app\"}[24h])",
          "legendFormat": "disponibilite",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "min": 0,
          "max": 1,
          "decimals": 2
        }
      },
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 4
      }
    },
    {
      "type": "stat",
      "title": "Alertes actives",
      "description": "",
