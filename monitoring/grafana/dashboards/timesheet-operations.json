        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "kube_deployment_spec_replicas{deployment=\"timesheet-app\"}",
          "legendFormat": "demandees",
          "refId": "B"
