          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"timesheet-app\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_requests_seconds_count{job=\"timesheet-app\"}[5m]))",
          "legendFormat": "erreurs",
          "refId": "A"
