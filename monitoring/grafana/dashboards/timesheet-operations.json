{
  "uid": "timesheet-ops",
  "title": "Timesheet - Operations (DevSecOps)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "devsecops",
    "operations"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application timesheet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "up{job=\"timesheet-app\"}",
          "legendFormat": "etat",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Alertes actives",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "alertes",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Repliques disponibles / demandees",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "kube_deployment_status_replicas_available{deployment=\"timesheet-app\"}",
          "legendFormat": "disponibles",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "kube_deployment_spec_replicas{deployment=\"timesheet-app\"}",
          "legendFormat": "demandees",
          "refId": "B"
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Repliques de timesheet-app (creux = panne injectee)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "kube_deployment_status_replicas_available{deployment=\"timesheet-app\"}",
          "legendFormat": "disponibles",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "kube_deployment_spec_replicas{deployment=\"timesheet-app\"}",
          "legendFormat": "demandees",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Trafic HTTP (requetes par seconde)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"timesheet-app\"}[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Historique des alertes Prometheus",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ops"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 30
          }
        }
      }
    }
  ]
}