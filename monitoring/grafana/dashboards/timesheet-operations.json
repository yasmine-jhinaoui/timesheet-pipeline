      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ops"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"timesheet-app\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"timesheet-app\"}[1m]))",
          "legendFormat": "latence",
          "refId": "A"
